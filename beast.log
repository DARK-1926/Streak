        elif line.lower().startswith('visa sponsorship:'):\n            current_field = 'visa_sponsorship'\n            result[current_field] = line[17:].strip()\n        elif line.lower().startswith('contact:'):\n            current_field = 'contact'\n            result[current_field] = line[8:].strip()\n        else:\n            # Continuation of current field\n            if current_field and result[current_field]:\n                result[current_field] += ' ' + line\n            elif current_field:\n                result[current_field] = line\n\n    # Validation\n    if not result['role']:\n        raise ValidationError(\"Missing required field: role\")\n    \n    if not result['technologies']:\n        raise ValidationError(\"Missing required field: technologies\")\n    \n    if not result['location']:\n        raise ValidationError(\"Missing required field: location\")\n    \n    if not result['contact']:\n        raise ValidationError(\"Missing required field: contact\")\n\n    return result\n\n\nclass ValidationError(Exception):\n    \"\"\"Raised when the input content doesn't match the expected format.\"\"\"\n    pass\n"}, {"filepath": "hireme/cli.py", "target_content": "", "replacement_content": "\"\"\"Command-line interface for HireMeParser.\"\"\"\n\nimport argparse\nimport json\nimport sys\nfrom typing import Dict\n\nfrom hireme.parser import parse_hn_hireme_post, ValidationError\n\n\ndef main() -> None:\n    \"\"\"Main entry point for the CLI.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Parse 'Who wants to be hired?' Hacker News posts.\"\n    )\n    parser.add_argument(\n        \"--input\",\n        type=str,\n        help=\"Input file path. If not provided, reads from stdin.\",\n    )\n    args = parser.parse_args()\n\n    try:\n        if args.input:\n            with open(args.input, \"r\", encoding=\"utf-8\") as f:\n                content = f.read()\n        else:\n            content = sys.stdin.read()\n\n        result = parse_hn_hireme_post(content)\n        print(json.dumps(result, indent=2))\n    except ValidationError as e:\n        print(f\"Validation error: {e}\", file=sys.stderr)\n        sys.exit(1)\n    except FileNotFoundError:\n        print(f\"Error: Input file not found.\", file=sys.stderr)\n        sys.exit(1)\n    except Exception as e:\n        print(f\"Unexpected error: {e}\", file=sys.stderr)\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n"}]}
