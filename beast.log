         return {\n                \"state\": self.state,\n                \"error_rate\": self.error_rate,\n                \"last_updated\": self.last_updated,\n                \"serialization_error\": str(exc)\n            }\n\n\n@dataclasses.dataclass(frozen=True)\nclass RoutingDecision:\n    \"\"\"Represents a deterministic routing decision based on circuit states.\n\n    Attributes:\n        task: The identifier or description of the agent task.\n        primary: The preferred provider selected for routing.\n        fallback: The backup provider if the primary is unavailable.\n        reason: Human-readable explanation for the routing choice.\n    \"\"\"\n    task: str\n    primary: str\n    fallback: str\n    reason: str\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serialize the routing decision to a dictionary for JSON encoding.\n\n        Returns:\n            A dictionary representation of the dataclass fields.\n        \"\"\"\n        try:\n            return dataclasses.asdict(self)\n        except Exception as exc:\n            return {\n                \"task\": self.task,\n                \"primary\": self.primary,\n                \"fallback\": self.fallback,\n                \"reason\": self.reason,\n                \"serialization_error\": str(exc)\n            }\n\n\n@dataclasses.dataclass(frozen=True)\nclass AuditReport:\n    \"\"\"Aggregates circuit breaker states, routing decisions, and detected anomalies.\n\n    Attributes:\n        breaker_states: Mapping of provider names to their current circuit states.\n        routing_decisions: Ordered list of routing decisions made during the audit.\n        anomalies: List of detected irregularities or policy violations.\n    \"\"\"\n    breaker_states: Dict[str, CircuitState]\n    routing_decisions: List[RoutingDecision]\n    anomalies: List[str]\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serialize the full audit report to a dictionary for JSON encoding.\n\n        Returns:\n            A nested dictionary representation of the report and its components.\n        \"\"\"\n        try:\n            return dataclasses.asdict(self)\n        except Exception as exc:\n            return {\n                \"breaker_states\": {k: v.to_dict() for k, v in self.breaker_states.items()},\n                \"routing_decisions\": [rd.to_dict() for rd in self.routing_decisions],\n                \"anomalies\": list(self.anomalies),\n                \"serialization_error\": str(exc)\n            }",
