ontent": "\"\"\"Command-line interface for HireMeParser.\"\"\"\n\nimport argparse\nimport json\nimport sys\nfrom typing import Dict\n\nfrom hireme.parser import parse_hn_hireme_post, ValidationError\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Parse 'Who wants to be hired?' Hacker News posts.\")\n    parser.add_argument(\n        \"--input\",\n        type=str,\n        help=\"Path to input file. If not provided, reads from stdin.\",\n    )\n    args = parser.parse_args()\n\n    if args.input:\n        with open(args.input, \"r\", encoding=\"utf-8\") as f:\n            content = f.read()\n    else:\n        content = sys.stdin.read()\n\n    try:\n        result: Dict[str, str] = parse_hn_hireme_post(content)\n        print(json.dumps(result, indent=2))\n    except ValidationError as e:\n        print(f\"Validation error: {e}\", file=sys.stderr)\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    main()\n"}]}
