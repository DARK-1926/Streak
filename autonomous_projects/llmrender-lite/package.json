{
  "name": "llmrender-lite",
  "version": "0.1.0",
  "description": "10 KB React Markdown + LaTeX renderer",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "lint": "eslint src/**/*.jsx"
  },
  "keywords": ["react", "markdown", "latex", "katex", "lite"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "marked": "^9.1.0",
    "katex": "^0.16.8"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.22.5",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.48.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "vite": "^5.0.10"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleFileExtensions": ["js", "jsx"],
    "setupFilesAfterEnv": ["@testing-library/jest-dom/extend-expect"]
  },
  "babel": {
    "presets": [
      "@babel/preset-react"
    ]
  }
}
